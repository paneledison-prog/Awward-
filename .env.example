# Port the server listens on.
PORT=3000

# Max time (ms) a single page render may take before the job fails.
EXTRACT_TIMEOUT_MS=60000

# How long finished jobs stay in memory before eviction.
JOB_TTL_MS=1800000

# Outbound proxy for the headless browser. Leave unset for normal deployments;
# set it when running behind a corporate or sandbox proxy.
# HTTPS_PROXY=http://proxy.internal:8080

# DEV ONLY. Tells Chromium to accept the MITM certificate presented by a
# development proxy. Never enable this in production.
# DEV_INSECURE_TLS=1

# Where full-page screenshots are written at runtime. Must not be inside
# public/: Next serves that directory from a manifest built at build time,
# so files written there afterwards are not served.
SCREENSHOT_DIR=.screenshots
