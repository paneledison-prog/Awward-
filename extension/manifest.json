{
  "manifest_version": 3,
  "name": "DesignDNA",
  "version": "1.2.0",
  "description": "Measure the design system of the page you are on, including sites that refuse automated browsers.",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract this page's design system"
  },
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
