{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".dev-build",
    "allowJs": false,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "app", "components"]
}
